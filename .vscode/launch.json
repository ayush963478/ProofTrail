{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: local API server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/local-server.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Frontend: vite dev server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Frontend: open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Run full stack (backend + frontend)",
      "configurations": ["Backend: local API server", "Frontend: vite dev server"],
      "stopAll": true
    }
  ]
}
