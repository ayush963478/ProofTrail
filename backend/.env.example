# Copy to .env and adjust. Local mode works with all defaults.

# ---- runtime profile ----------------------------------------------------
# aws | local  (auto: aws when MODE unset AND MAIN_TABLE / LEDGER_TABLE /
#               ANCHOR_TABLE / STAGING_BUCKET / VAULT_BUCKET present, else local)
MODE=local
# cognito | dev (auto: cognito when MODE=aws, dev when MODE=local)
AUTH_MODE=dev
# rfc3161 | local (auto: rfc3161 when MODE=aws, local when MODE=local)
TSA_MODE=local
PORT=4000

# ---- auth ---------------------------------------------------------------
DEV_JWT_SECRET=change-me-to-a-long-random-string
# token used by capture-service callbacks
SERVICE_TOKEN=change-me-to-another-long-random-string

# ---- verification links -------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# ---- timestamp authority (RFC 3161) -------------------------------------
# rfc3161 (default) | local (dev-only, flagged in the proof as mode:"local")
TSA_MODE=rfc3161
TSA_URL=https://freetsa.org/tsr
TSA_CERT_URL=https://freetsa.org/tsa.crt

# ---- audit --------------------------------------------------------------
AUDIT_SALT=change-me-audit-salt

# ---- local mode storage -------------------------------------------------
# DATA_DIR=C:\path\to\backend\.data

# ---- aws mode: dynamodb -------------------------------------------------
MAIN_TABLE=prooftrail-main
LEDGER_TABLE=prooftrail-ledger
ANCHOR_TABLE=prooftrail-anchor
AUDIT_TABLE=prooftrail-audit
CAPTURE_TABLE=prooftrail-capture

# ---- aws mode: s3 -------------------------------------------------------
STAGING_BUCKET=
VAULT_BUCKET=
VAULT_RETENTION_DAYS=2555

# ---- aws mode: kms signing ---------------------------------------------
AWS_REGION=us-east-1
KMS_KEY_ID=alias/prooftrail-signing

# ---- aws mode: sqs seal queue ------------------------------------------
# consumed by src/handlers/sealWorker.js (SQS event source)
SQS_SEAL_QUEUE_URL=

# ---- aws mode: ecs fargate capture -------------------------------------
CAPTURE_CLUSTER=
CAPTURE_TASK_DEF=
CAPTURE_SUBNETS=
CAPTURE_SG=

# ---- anchoring ----------------------------------------------------------
# optional external endpoint that receives published Merkle roots
ANCHOR_EXTERNAL_URL=
# ANCHOR_BATCH_CAP=500
# ANCHOR_INTERVAL_MS=900000   # local-mode auto-anchor timer (15 min)

# ---- limits / rate limiting (defaults shown) ----------------------------
# MAX_BODY_BYTES=104857600
# MAX_EVIDENCE_SIZE=104857600
# RATE_LIMIT_PUBLIC=60
# RATE_LIMIT_AUTHED=300

# ---- misc (defaults shown) ---------------------------------------------
# API_BASE_URL=http://localhost:4000    # backend's own base URL (uploadUrl)
# ACTIVE_SIGNING_KEY=                  # override active key id
# TSA_TIMEOUT_MS=15000
# TSA_RETRIES=2
# AUDIT_TTL_DAYS=365
