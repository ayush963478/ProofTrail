# ProofTrail frontend environment
# Copy to .env and adjust. `npm run dev` serves the app on http://localhost:5173

# Backend API base URL (AWS: API Gateway HTTP API URL; local: node server)
VITE_API_BASE_URL=http://localhost:4000

# Public base URL used to build verification links ({PUBLIC_BASE_URL}/verify/{token})
VITE_PUBLIC_BASE_URL=http://localhost:5173

# Fallback auth mode only — the app always prefers GET /meta -> authMode
# cognito | dev
VITE_AUTH_MODE=dev

# Required when authMode is "cognito"
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
